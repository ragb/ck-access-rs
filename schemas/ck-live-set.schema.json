{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LiveSet",
  "description": "One Live Set patch: common settings, EQ, four Zones (1..4) and three Parts (A/B/C). The Audio Trigger wave-file path is kept as a string.",
  "type": "object",
  "required": [
    "common",
    "eq",
    "parts",
    "zones"
  ],
  "properties": {
    "audio_trigger_path": {
      "description": "Path to the audio-trigger sample file (may be empty).",
      "type": "string"
    },
    "common": {
      "$ref": "#/definitions/LiveSetCommon"
    },
    "eq": {
      "$ref": "#/definitions/LiveSetEq"
    },
    "extra_blocks": {
      "description": "Blocks present in the dump that this crate doesn't model individually (Soundmondo format version, other firmware-specific blocks), kept verbatim.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/RawBlock"
      }
    },
    "parts": {
      "description": "The three Parts (A, B, C).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Part"
      }
    },
    "rotary": {
      "description": "Rotary Speaker settings (firmware v1.10+). `None` on firmware that doesn't emit the `46 20 00` block.",
      "anyOf": [
        {
          "$ref": "#/definitions/RotarySpeaker"
        },
        {
          "type": "null"
        }
      ]
    },
    "zones": {
      "description": "The four Zones (master-keyboard transmit configs).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Zone"
      }
    }
  },
  "definitions": {
    "AudioTriggerKey": {
      "description": "Which held key triggers the audio sample (offset 0x35).",
      "type": "string",
      "enum": [
        "lowest",
        "highest"
      ]
    },
    "AudioTriggerPlayMode": {
      "description": "Audio-trigger playback behaviour (offset 0x36). `Hold` added in CK firmware v1.10.",
      "type": "string",
      "enum": [
        "one_shot",
        "play_stop",
        "play_pause",
        "hold"
      ]
    },
    "DelayType": {
      "description": "Master Delay algorithm (offset 0x28).",
      "type": "string",
      "enum": [
        "digital",
        "analog",
        "cross",
        "tempo"
      ]
    },
    "DriveType": {
      "description": "Drive/amp model (offset 0x57).",
      "type": "string",
      "enum": [
        "over_drive",
        "distortion",
        "rotary_a",
        "rotary_b",
        "comp"
      ]
    },
    "EffectSelect": {
      "description": "Which insert-effect slot the part edits (offset 0x1B).",
      "type": "string",
      "enum": [
        "effect1",
        "effect2"
      ]
    },
    "ExternalKeyboard": {
      "description": "External-keyboard routing (offset 0x39).",
      "type": "string",
      "enum": [
        "ext_int",
        "ext_only",
        "off"
      ]
    },
    "LiveSetCommon": {
      "description": "The Live Set **Common** block.",
      "type": "object",
      "required": [
        "ad_effect_1_depth",
        "ad_effect_1_rate",
        "ad_effect_1_type",
        "ad_effect_2_depth",
        "ad_effect_2_rate",
        "ad_effect_2_type",
        "ad_eq_high_freq",
        "ad_eq_high_gain",
        "ad_eq_low_freq",
        "ad_eq_low_gain",
        "ad_eq_mid_freq",
        "ad_eq_mid_gain",
        "ad_noise_gate_switch",
        "ad_noise_gate_threshold",
        "ad_volume",
        "advanced_zone",
        "audio_trigger_key",
        "audio_trigger_play_mode",
        "audio_trigger_switch",
        "audio_trigger_volume",
        "delay_depth",
        "delay_switch",
        "delay_tempo_time",
        "delay_time",
        "delay_type",
        "foot_pedal_1_assign",
        "foot_pedal_1_limit_high",
        "foot_pedal_1_limit_low",
        "foot_pedal_2_assign",
        "foot_pedal_2_limit_high",
        "foot_pedal_2_limit_low",
        "layer_split_mode",
        "live_set_eq_mode",
        "master_keyboard_mode",
        "mod_wheel_assign",
        "name",
        "reverb_depth",
        "reverb_switch",
        "reverb_type",
        "rotary_speed",
        "rotary_stop",
        "sound_transpose",
        "split_point",
        "split_point_a_b",
        "split_point_b_c",
        "tempo_x10"
      ],
      "properties": {
        "ad_effect_1_depth": {
          "description": "A/D effect 1 depth, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "ad_effect_1_rate": {
          "description": "A/D effect 1 rate, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "ad_effect_1_type": {
          "description": "A/D effect 1 type, raw 0x00..=0x22.",
          "type": "integer",
          "format": "uint8",
          "maximum": 34.0,
          "minimum": 0.0
        },
        "ad_effect_2_depth": {
          "description": "A/D effect 2 depth, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "ad_effect_2_rate": {
          "description": "A/D effect 2 rate, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "ad_effect_2_type": {
          "description": "A/D effect 2 type, raw 0x00..=0x22.",
          "type": "integer",
          "format": "uint8",
          "maximum": 34.0,
          "minimum": 0.0
        },
        "ad_eq_high_freq": {
          "description": "A/D input EQ high frequency, raw 0x1C..=0x3A.",
          "type": "integer",
          "format": "uint8",
          "maximum": 58.0,
          "minimum": 28.0
        },
        "ad_eq_high_gain": {
          "description": "A/D input EQ high gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 12.0,
          "minimum": -12.0
        },
        "ad_eq_low_freq": {
          "description": "A/D input EQ low frequency, raw 0x04..=0x28.",
          "type": "integer",
          "format": "uint8",
          "maximum": 40.0,
          "minimum": 4.0
        },
        "ad_eq_low_gain": {
          "description": "A/D input EQ low gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 12.0,
          "minimum": -12.0
        },
        "ad_eq_mid_freq": {
          "description": "A/D input EQ mid frequency, raw 0x0E..=0x36.",
          "type": "integer",
          "format": "uint8",
          "maximum": 54.0,
          "minimum": 14.0
        },
        "ad_eq_mid_gain": {
          "description": "A/D input EQ mid gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 12.0,
          "minimum": -12.0
        },
        "ad_noise_gate_switch": {
          "description": "A/D input noise gate on/off.",
          "type": "boolean"
        },
        "ad_noise_gate_threshold": {
          "description": "Noise-gate threshold, raw 0x36..=0x61 (−73 .. −30 dB).",
          "type": "integer",
          "format": "uint8",
          "maximum": 97.0,
          "minimum": 54.0
        },
        "ad_volume": {
          "description": "A/D input channel volume, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "advanced_zone": {
          "description": "Enables advanced zone settings for the external keyboard.",
          "type": "boolean"
        },
        "audio_trigger_key": {
          "description": "Which held key triggers the audio sample (lowest/highest).",
          "allOf": [
            {
              "$ref": "#/definitions/AudioTriggerKey"
            }
          ]
        },
        "audio_trigger_play_mode": {
          "description": "Audio-trigger playback behaviour (OneShot, PlayStop, PlayPause, Hold).",
          "allOf": [
            {
              "$ref": "#/definitions/AudioTriggerPlayMode"
            }
          ]
        },
        "audio_trigger_switch": {
          "description": "Audio-trigger sample playback on/off.",
          "type": "boolean"
        },
        "audio_trigger_volume": {
          "description": "Audio-trigger sample volume, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "delay_depth": {
          "description": "Master Delay depth (send/mix amount), 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "delay_switch": {
          "description": "Master delay on/off.",
          "type": "boolean"
        },
        "delay_tempo_time": {
          "description": "Tempo-delay note value, raw 0..=14.",
          "type": "integer",
          "format": "uint8",
          "maximum": 14.0,
          "minimum": 0.0
        },
        "delay_time": {
          "description": "Master Delay time, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "delay_type": {
          "description": "Delay algorithm (Digital, Analog, Cross, Tempo).",
          "allOf": [
            {
              "$ref": "#/definitions/DelayType"
            }
          ]
        },
        "foot_pedal_1_assign": {
          "description": "Foot Pedal 1 assignment, raw 0..=120.",
          "type": "integer",
          "format": "uint8",
          "maximum": 120.0,
          "minimum": 0.0
        },
        "foot_pedal_1_limit_high": {
          "description": "Foot Pedal 1 upper limit, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "foot_pedal_1_limit_low": {
          "description": "Foot Pedal 1 lower limit, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "foot_pedal_2_assign": {
          "description": "Foot Pedal 2 assignment, raw 0..=120.",
          "type": "integer",
          "format": "uint8",
          "maximum": 120.0,
          "minimum": 0.0
        },
        "foot_pedal_2_limit_high": {
          "description": "Foot Pedal 2 upper limit, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "foot_pedal_2_limit_low": {
          "description": "Foot Pedal 2 lower limit, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "layer_split_mode": {
          "description": "Layer/split layout, raw 0..=3: 0=ABC, 1=A/BC, 2=AB/C, 3=A/B/C.",
          "type": "integer",
          "format": "uint8",
          "maximum": 3.0,
          "minimum": 0.0
        },
        "live_set_eq_mode": {
          "description": "Enables the per-Live-Set 3-band EQ.",
          "type": "boolean"
        },
        "master_keyboard_mode": {
          "description": "Enables Master Keyboard mode (external-zone control).",
          "type": "boolean"
        },
        "mod_wheel_assign": {
          "description": "Modulation wheel assignment, raw 0..=120 (control number; 120 = USB audio volume).",
          "type": "integer",
          "format": "uint8",
          "maximum": 120.0,
          "minimum": 0.0
        },
        "name": {
          "description": "Live Set name, up to 15 ASCII characters.",
          "type": "string"
        },
        "reserved": {
          "description": "Reserved/undocumented bytes captured verbatim so writes round-trip exactly.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RawByte"
          }
        },
        "reverb_depth": {
          "description": "Master Reverb depth (send/mix amount), 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "reverb_switch": {
          "description": "Master reverb on/off.",
          "type": "boolean"
        },
        "reverb_type": {
          "description": "Reverb algorithm (Hall, Room, Plate).",
          "allOf": [
            {
              "$ref": "#/definitions/ReverbType"
            }
          ]
        },
        "rotary_speed": {
          "description": "Rotary speaker speed (slow/fast).",
          "allOf": [
            {
              "$ref": "#/definitions/RotarySpeed"
            }
          ]
        },
        "rotary_stop": {
          "description": "Stops the rotary speaker (brake).",
          "type": "boolean"
        },
        "sound_transpose": {
          "description": "Sound transpose, −12..=+12 semitones.",
          "type": "integer",
          "format": "int8",
          "maximum": 12.0,
          "minimum": -12.0
        },
        "split_point": {
          "description": "Split point (two-way split), raw 1..=127 (note number).",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 1.0
        },
        "split_point_a_b": {
          "description": "Split point A–B (three-way), raw 1..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 1.0
        },
        "split_point_b_c": {
          "description": "Split point B–C (three-way), raw 2..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 2.0
        },
        "tempo_x10": {
          "description": "Tempo ×10 (e.g. `1200` = 120.0 BPM); raw range 420..=2400.",
          "type": "integer",
          "format": "uint16",
          "maximum": 2400.0,
          "minimum": 420.0
        }
      }
    },
    "LiveSetEq": {
      "description": "The Live Set **EQ** block — a 3-band EQ, same layout as the System Master EQ.",
      "type": "object",
      "required": [
        "high_freq",
        "high_gain",
        "low_freq",
        "low_gain",
        "mid_freq",
        "mid_gain"
      ],
      "properties": {
        "high_freq": {
          "description": "High frequency, raw 0x1C..=0x3A.",
          "type": "integer",
          "format": "uint8",
          "maximum": 58.0,
          "minimum": 28.0
        },
        "high_gain": {
          "description": "High gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 12.0,
          "minimum": -12.0
        },
        "low_freq": {
          "description": "Low frequency, raw 0x04..=0x28.",
          "type": "integer",
          "format": "uint8",
          "maximum": 40.0,
          "minimum": 4.0
        },
        "low_gain": {
          "description": "Low gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 12.0,
          "minimum": -12.0
        },
        "mid_freq": {
          "description": "Mid frequency, raw 0x0E..=0x36.",
          "type": "integer",
          "format": "uint8",
          "maximum": 54.0,
          "minimum": 14.0
        },
        "mid_gain": {
          "description": "Mid gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8",
          "maximum": 12.0,
          "minimum": -12.0
        },
        "reserved": {
          "description": "Reserved/undocumented bytes captured verbatim so writes round-trip exactly.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RawByte"
          }
        }
      }
    },
    "MonoPoly": {
      "description": "Voice allocation (offset 0x20).",
      "type": "string",
      "enum": [
        "mono",
        "poly"
      ]
    },
    "MonoType": {
      "description": "Mono/portamento behaviour (offset 0x21).",
      "type": "string",
      "enum": [
        "normal",
        "fingered_portamento",
        "full_time_portamento"
      ]
    },
    "Part": {
      "description": "One Live Set Part.",
      "type": "object",
      "required": [
        "amplifier_modulation_depth",
        "category_voices",
        "current_category",
        "drawbars",
        "drive_depth",
        "drive_switch",
        "drive_type",
        "effect_1_depth",
        "effect_1_rate",
        "effect_1_switch",
        "effect_1_type",
        "effect_2_depth",
        "effect_2_rate",
        "effect_2_switch",
        "effect_2_type",
        "effect_select",
        "eg_attack",
        "eg_release",
        "eg_switch",
        "external_keyboard",
        "filter_cutoff",
        "filter_modulation_depth",
        "filter_resonance",
        "filter_switch",
        "modulation_speed",
        "mono_poly",
        "mono_type",
        "note_shift",
        "pan",
        "part_color",
        "part_selected",
        "part_switch",
        "part_volume",
        "percussion_decay",
        "percussion_switch",
        "percussion_type",
        "percussion_volume",
        "pitch_bend_range",
        "pitch_modulation_depth",
        "portamento_mode",
        "portamento_time",
        "receive_expression",
        "receive_soft",
        "receive_sostenuto",
        "receive_sustain",
        "touch_sensitivity_depth",
        "touch_sensitivity_offset",
        "unison_detune",
        "unison_switch",
        "unison_type",
        "unison_volume",
        "vibrato_chorus_switch",
        "vibrato_chorus_type"
      ],
      "properties": {
        "amplifier_modulation_depth": {
          "description": "Amplifier modulation depth, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "category_voices": {
          "description": "Selected voice number per category (10 entries). Each is the absolute voice number for that category — see [`crate::voices`].",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0.0
          }
        },
        "current_category": {
          "description": "Active category, 0..=9 (indexes `category_voices`).",
          "type": "integer",
          "format": "uint8",
          "maximum": 9.0,
          "minimum": 0.0
        },
        "drawbars": {
          "description": "Organ drawbars, 9 entries: 16', 5⅓', 8', 4', 2⅔', 2', 1⅗', 1⅓', 1'.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          }
        },
        "drive_depth": {
          "description": "Drive depth, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "drive_switch": {
          "description": "Enables the drive/amp stage.",
          "type": "boolean"
        },
        "drive_type": {
          "description": "Drive/amp model.",
          "allOf": [
            {
              "$ref": "#/definitions/DriveType"
            }
          ]
        },
        "effect_1_depth": {
          "description": "Effect 1 depth, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "effect_1_rate": {
          "description": "Effect 1 rate, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "effect_1_switch": {
          "description": "Insert effect 1 on/off.",
          "type": "boolean"
        },
        "effect_1_type": {
          "description": "Effect 1 type, raw 0x00..=0x23.",
          "type": "integer",
          "format": "uint8",
          "maximum": 35.0,
          "minimum": 0.0
        },
        "effect_2_depth": {
          "description": "Effect 2 depth, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "effect_2_rate": {
          "description": "Effect 2 rate, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "effect_2_switch": {
          "description": "Insert effect 2 on/off.",
          "type": "boolean"
        },
        "effect_2_type": {
          "description": "Effect 2 type, raw 0x00..=0x23.",
          "type": "integer",
          "format": "uint8",
          "maximum": 35.0,
          "minimum": 0.0
        },
        "effect_select": {
          "description": "Which insert-effect slot this part edits (Effect1/Effect2).",
          "allOf": [
            {
              "$ref": "#/definitions/EffectSelect"
            }
          ]
        },
        "eg_attack": {
          "description": "EG attack, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "eg_release": {
          "description": "EG release, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "eg_switch": {
          "description": "Enables the amplitude envelope generator.",
          "type": "boolean"
        },
        "external_keyboard": {
          "description": "External-keyboard routing (ExtInt, ExtOnly, Off).",
          "allOf": [
            {
              "$ref": "#/definitions/ExternalKeyboard"
            }
          ]
        },
        "filter_cutoff": {
          "description": "Filter cutoff, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "filter_modulation_depth": {
          "description": "Filter modulation depth, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "filter_resonance": {
          "description": "Filter resonance, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "filter_switch": {
          "description": "Enables the filter.",
          "type": "boolean"
        },
        "modulation_speed": {
          "description": "Modulation speed, −64..=+63.",
          "type": "integer",
          "format": "int8",
          "maximum": 63.0,
          "minimum": -64.0
        },
        "mono_poly": {
          "description": "Plays this part monophonically or polyphonically.",
          "allOf": [
            {
              "$ref": "#/definitions/MonoPoly"
            }
          ]
        },
        "mono_type": {
          "description": "Mono/portamento behaviour (Normal, Fingered, Full-time).",
          "allOf": [
            {
              "$ref": "#/definitions/MonoType"
            }
          ]
        },
        "note_shift": {
          "description": "Note shift, −24..=+24 semitones.",
          "type": "integer",
          "format": "int8",
          "maximum": 24.0,
          "minimum": -24.0
        },
        "pan": {
          "description": "Stereo pan, −63..=+63 (L63 .. C .. R63). Added in CK firmware v1.10 (Part block offset 0x1C; device-verified by capture-and-diff).",
          "type": "integer",
          "format": "int8",
          "maximum": 63.0,
          "minimum": -63.0
        },
        "part_color": {
          "description": "Part colour, 0..=11 (0=Red .. 11=Rose).",
          "type": "integer",
          "format": "uint8",
