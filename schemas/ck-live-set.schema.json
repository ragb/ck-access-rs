        "a_rotor_slow",
        "a_stereo_mono",
        "b_balance",
        "b_horn_fast",
        "b_horn_slow",
        "b_horn_transition",
        "b_rotor_fast",
        "b_rotor_slow",
        "b_rotor_transition",
        "b_stereo_mono"
      ],
      "properties": {
        "a_balance": {
          "description": "Rotary A balance (horn vs rotor), raw 0..=127 (R63>H .. R=H .. R<H63).",
          "type": "integer",
          "format": "uint8",
          "maximum": 127.0,
          "minimum": 0.0
        },
        "a_horn_acceleration": {
          "description": "Rotary A horn acceleration index (0.21–2.00).",
