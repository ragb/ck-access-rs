{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "System",
  "description": "The global System settings: Common block + Master EQ.",
  "type": "object",
  "required": [
    "common",
    "master_eq"
  ],
  "properties": {
    "common": {
      "$ref": "#/definitions/SystemCommon"
    },
    "master_eq": {
      "$ref": "#/definitions/MasterEq"
    }
  },
  "definitions": {
    "ControllerMode": {
      "description": "Knob pickup behaviour (offset 0x1C).",
      "type": "string",
      "enum": [
        "jump",
        "catch"
      ]
    },
    "ControllerReset": {
      "description": "What \"controller reset\" does on Live Set change (offset 0x08).",
      "type": "string",
      "enum": [
        "hold",
        "reset"
      ]
    },
    "FootPedalLiveSet": {
      "description": "Foot-pedal Live Set increment/decrement assignment (offsets 0x2B / 0x2D).",
      "type": "string",
      "enum": [
        "off",
        "inc",
        "dec"
      ]
    },
    "FootPedalType": {
      "description": "Foot-pedal hardware type (offsets 0x2A / 0x2C).",
      "type": "string",
      "enum": [
        "fc3a_half_on",
        "fc3a_half_off",
        "fc4a_fc5",
        "fc7"
      ]
    },
    "MasterEq": {
      "description": "The System **Master EQ** block — a 3-band EQ.",
      "type": "object",
      "required": [
        "high_freq",
        "high_gain",
        "low_freq",
        "low_gain",
        "mid_freq",
        "mid_gain"
      ],
      "properties": {
        "high_freq": {
          "description": "High frequency, raw `0x1C..=0x3A` (500 Hz – 16 kHz).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "high_gain": {
          "description": "High gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8"
        },
        "low_freq": {
          "description": "Low frequency, raw `0x04..=0x28` (32 Hz – 2.0 kHz).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "low_gain": {
          "description": "Low gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8"
        },
        "mid_freq": {
          "description": "Mid frequency, raw `0x0E..=0x36` (100 Hz – 10 kHz).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "mid_gain": {
          "description": "Mid gain, −12..=+12 dB.",
          "type": "integer",
          "format": "int8"
        },
        "reserved": {
          "description": "Reserved/undocumented bytes captured verbatim so writes round-trip exactly.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RawByte"
          }
        }
      }
    },
    "RawByte": {
      "description": "A single raw byte the typed model doesn't interpret — a documented-reserved offset that the device nonetheless populates, or a trailing byte added by newer firmware. Captured so every area round-trips byte-exact even where the manual is silent.",
      "type": "object",
      "required": [
        "offset",
        "value"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "value": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        }
      }
    },
    "SpeakerMode": {
      "description": "Speaker voicing (offset 0x36).",
      "type": "string",
      "enum": [
        "normal",
        "table"
      ]
    },
    "SpeakerMute": {
      "description": "Speaker mute behaviour (offset 0x37).",
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ]
    },
    "SystemCommon": {
      "description": "The System **Common** block.",
      "type": "object",
      "required": [
        "ad_volume",
        "bluetooth_volume",
        "controller_mode",
        "controller_reset",
        "effect_on_off_reset",
        "filter_eg_reset",
        "fixed_velocity",
        "foot_pedal_1_live_set",
        "foot_pedal_1_type",
        "foot_pedal_2_live_set",
        "foot_pedal_2_type",
        "keyboard_octave_shift",
        "keyboard_transpose",
        "lcd_contrast",
        "lcd_switch",
        "local_control",
        "master_tune",
        "midi_control",
        "midi_in_out",
        "output_gain",
        "panel_lock_delay_reverb",
        "panel_lock_drive_effect",
        "panel_lock_equalizer",
        "panel_lock_filter_eg",
        "panel_lock_live_set",
        "panel_lock_organ",
        "power_on_page",
        "power_on_sound",
        "rx_channel",
        "speaker_mode",
        "speaker_mute",
        "touch_curve",
        "tx_channel",
        "tx_rx_bank_select",
        "tx_rx_program_change",
        "usb_audio_loopback",
        "usb_audio_volume",
        "usb_in_out",
        "value_indication"
      ],
      "properties": {
        "ad_volume": {
          "description": "A/D input volume, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "bluetooth_volume": {
          "description": "Bluetooth volume, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "controller_mode": {
          "$ref": "#/definitions/ControllerMode"
        },
        "controller_reset": {
          "$ref": "#/definitions/ControllerReset"
        },
        "effect_on_off_reset": {
          "type": "boolean"
        },
        "filter_eg_reset": {
          "type": "boolean"
        },
        "fixed_velocity": {
          "description": "Fixed velocity used when `touch_curve = fixed`, 1..=127.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "foot_pedal_1_live_set": {
          "$ref": "#/definitions/FootPedalLiveSet"
        },
        "foot_pedal_1_type": {
          "$ref": "#/definitions/FootPedalType"
        },
        "foot_pedal_2_live_set": {
          "$ref": "#/definitions/FootPedalLiveSet"
        },
        "foot_pedal_2_type": {
          "$ref": "#/definitions/FootPedalType"
        },
        "keyboard_octave_shift": {
          "description": "Keyboard octave shift, −3..=+3.",
          "type": "integer",
          "format": "int8"
        },
        "keyboard_transpose": {
          "description": "Keyboard transpose, −12..=+12 semitones.",
          "type": "integer",
          "format": "int8"
        },
        "lcd_contrast": {
          "description": "LCD contrast, −10..=+10.",
          "type": "integer",
          "format": "int8"
        },
        "lcd_switch": {
          "type": "boolean"
        },
        "local_control": {
          "type": "boolean"
        },
        "master_tune": {
          "description": "Master Tune, raw 16-bit value (`414.72–466.78 Hz`; default `0x0400`).",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "midi_control": {
          "type": "boolean"
        },
        "midi_in_out": {
          "type": "boolean"
        },
        "output_gain": {
          "description": "Output gain, raw `0x38..=0x48` (`−24..0..+24 dB`, default `0x3E`).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "panel_lock_delay_reverb": {
          "type": "boolean"
        },
        "panel_lock_drive_effect": {
          "type": "boolean"
        },
        "panel_lock_equalizer": {
          "type": "boolean"
        },
        "panel_lock_filter_eg": {
          "type": "boolean"
        },
        "panel_lock_live_set": {
          "type": "boolean"
        },
        "panel_lock_organ": {
          "type": "boolean"
        },
        "power_on_page": {
          "description": "Power-on page, raw `0..=0x13` (Live Set page 1–20).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "power_on_sound": {
          "description": "Power-on sound, raw `0..=0x07` (sound 1–8).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "reserved": {
          "description": "Reserved/undocumented bytes captured verbatim so writes round-trip exactly.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RawByte"
          }
        },
        "rx_channel": {
          "description": "MIDI receive channel, raw `0..=0x10` (`0..=15` = ch 1–16, `0x10` = All).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "speaker_mode": {
          "$ref": "#/definitions/SpeakerMode"
        },
        "speaker_mute": {
          "$ref": "#/definitions/SpeakerMute"
        },
        "touch_curve": {
          "$ref": "#/definitions/TouchCurve"
        },
        "tx_channel": {
          "description": "MIDI transmit channel, raw `0..=0x7F` (`0..=15` = ch 1–16, higher = Off).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "tx_rx_bank_select": {
          "type": "boolean"
        },
        "tx_rx_program_change": {
          "type": "boolean"
        },
        "usb_audio_loopback": {
          "type": "boolean"
        },
        "usb_audio_volume": {
          "description": "USB audio volume, 0..=127.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "usb_in_out": {
          "type": "boolean"
        },
        "value_indication": {
          "type": "boolean"
        }
      }
    },
    "TouchCurve": {
      "description": "Keyboard touch (velocity) curve (offset 0x10).",
      "type": "string",
      "enum": [
        "normal",
        "soft",
        "hard",
        "wide",
        "fixed"
      ]
    }
  }
}
